SERVICE_NAME=document-service
ENVIRONMENT=development
LOG_LEVEL=INFO

MONGODB_URI=mongodb://root:examplepassword@mongodb:27017
DOCUMENT_DB_NAME=synapse_document

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=synapse_user
POSTGRES_PASSWORD=synapse_password
VECTORS_DB_NAME=synapse_vectors
VECTORS_DB_URL=postgresql+asyncpg://synapse_user:synapse_password@postgres:5432/synapse_vectors

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=synapse-documents
MINIO_SECURE=false

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=synapse
RABBITMQ_PASSWORD=synapse_pass
RABBITMQ_URL=amqp://synapse:synapse_pass@rabbitmq:5672/

LLM_PROVIDER=google
GEMINI_API_KEY=your_gemini_api_key_here
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1024

JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
