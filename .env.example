# General Settings
ENVIRONMENT=development
LOG_LEVEL=info

# Service URLs
GATEWAY_URL=http://localhost:8000
IDENTITY_SERVICE_URL=http://localhost:8001
WORKSPACE_SERVICE_URL=http://localhost:8002
DOCUMENT_SERVICE_URL=http://localhost:8003
AI_SERVICE_URL=http://localhost:8004
RAG_SERVICE_URL=http://localhost:8005

# PostgreSQL (Single Instance, 2 Logical DBs)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=synapse_user
POSTGRES_PASSWORD=synapse_password
IDENTITY_DB_URL=postgresql+asyncpg://synapse_user:synapse_password@localhost:5432/synapse_identity
VECTORS_DB_URL=postgresql+asyncpg://synapse_user:synapse_password@localhost:5432/synapse_vectors

# MongoDB (Single Instance, 3 Logical DBs)
MONGODB_URI=mongodb://root:examplepassword@localhost:27017
WORKSPACE_DB_NAME=synapse_workspace
DOCUMENT_DB_NAME=synapse_document
CHAT_DB_NAME=synapse_chat

# Cache & Messaging
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://synapse:synapse_pass@localhost:5672/

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=synapse-documents

# External AI Services
GEMINI_API_KEY=your_gemini_api_key_here
LLAMA_CLOUD_API_KEY=your_llama_parse_key_here

# JWT Auth
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
