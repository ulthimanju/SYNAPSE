# ==============================================================================
# Synapse Platform - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Logging
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_NAME=synapse-service

# ------------------------------------------------------------------------------
# 2. Network Service URLs (Internal Microservices & Gateway)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
GATEWAY_URL=http://localhost:8000
IDENTITY_SERVICE_URL=http://identity-service:8001
WORKSPACE_SERVICE_URL=http://workspace-service:8002
DOCUMENT_SERVICE_URL=http://document-service:8003
AI_SERVICE_URL=http://ai-service:8004
RAG_SERVICE_URL=http://rag-service:8005

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (pgvector Enabled)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=synapse_user
POSTGRES_PASSWORD=synapse_password
POSTGRES_DB=synapse_identity
VECTORS_DB_NAME=synapse_vectors
IDENTITY_DB_URL=postgresql+asyncpg://synapse_user:synapse_password@postgres:5432/synapse_identity
VECTORS_DB_URL=postgresql+asyncpg://synapse_user:synapse_password@postgres:5432/synapse_vectors

# ------------------------------------------------------------------------------
# 4. MongoDB Database (Beanie ODM & Documents)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://root:examplepassword@mongodb:27017
MONGODB_DB_NAME=synapse_workspace
MONGODB_USER=root
MONGODB_PASSWORD=examplepassword
WORKSPACE_DB_NAME=synapse_workspace
DOCUMENT_DB_NAME=synapse_document
CHAT_DB_NAME=synapse_chat

# ------------------------------------------------------------------------------
# 5. Redis Cache & State Store
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 6. RabbitMQ Message Broker
# ------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=synapse
RABBITMQ_PASSWORD=synapse_pass
RABBITMQ_URL=amqp://synapse:synapse_pass@rabbitmq:5672/

# ------------------------------------------------------------------------------
# 7. MinIO S3-Compatible Object Storage
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=synapse-documents
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# 8. AI Stack & Provider Models Configuration
# ------------------------------------------------------------------------------
LLM_PROVIDER=google
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
JINA_API_KEY=your_jina_api_key_here

LLM_PRIMARY_MODEL=gemini-3.6-flash
LLM_VISION_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1024
RERANKER_MODEL=jina-reranker-v2-base-multilingual

# ------------------------------------------------------------------------------
# 9. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 10. External OAuth & Third-Party Integrations
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback
